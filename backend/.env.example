# ==============================================
# 필수 환경 변수
# ==============================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Google OAuth (YouTube API)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Settings
JWT_SECRET_KEY=your-secret-key-here-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Lightsail PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database_name

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-s3-bucket-name

# ==============================================
# AI 서비스 API Keys
# ==============================================

# Nano Banana (이미지 생성)
NANO_BANANA_API_KEY=your-api-key
NANO_BANANA_MODEL=models/gemini-2.5-flash-image
NANO_BANANA_STORAGE_BACKEND=s3
NANO_BANANA_OUTPUT_DIR=data/images
NANO_BANANA_TEMP_DIR=data/images/tmp
NANO_BANANA_PUBLIC_BASE_URL=
NANO_BANANA_S3_BUCKET=your-s3-bucket-name
NANO_BANANA_S3_REGION=ap-northeast-2
NANO_BANANA_STORAGE_PREFIX=images

# ElevenLabs (음성 생성)
ELEVENLABS_API_KEY=your-api-key
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_TTV_MODEL_ID=eleven_multilingual_ttv_v2

# Qwen3 TTS (음성 생성)
QWEN_TTS_VOICE_DESIGN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QWEN_TTS_BASE_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_TTS_DEVICE=cpu
QWEN_TTS_DTYPE=bfloat16
QWEN_TTS_ATTN_IMPL=flash_attention_2
QWEN_TTS_SEED=42

VOICE_PROVIDER=qwen
VOICE_STORAGE_BACKEND=s3
VOICE_STORAGE_BASE_DIR=data/voice
VOICE_TEMP_DIR=data/voice/tmp
VOICE_PUBLIC_BASE_URL=
VOICE_S3_BUCKET=your-s3-bucket-name
VOICE_S3_REGION=ap-northeast-2

# ==============================================
# ComfyUI (영상 생성)
# ==============================================

COMFY_MODE=comfyui
COMFY_COMFYUI_BASE_URL=http://your-comfyui-server:port
COMFY_WORKFLOW_PATH=/path/to/workflow.json
COMFY_OUTPUT_DIR=data/video
COMFY_TEMP_DIR=data/video/tmp
COMFY_STORAGE_BACKEND=s3
COMFY_PUBLIC_BASE_URL=
COMFY_S3_BUCKET=your-s3-bucket-name
COMFY_S3_REGION=ap-northeast-2
COMFY_STORAGE_PREFIX=videos
COMFY_REQUEST_TIMEOUT_SEC=180
COMFY_POLL_INTERVAL_SEC=2.0
COMFY_MAX_WAIT_SEC=900

# SSH 설정 (ComfyUI 이미지 업로드용)
COMFY_SSH_HOST=your-server-ip
COMFY_SSH_PORT=22
COMFY_SSH_USER=root
COMFY_SSH_KEY=/path/to/ssh/key
COMFY_WORKFLOW_BASE=/app/AI
COMFY_REMOTE_INPUT_DIR=/workspace/ComfyUI/input
COMFY_REMOTE_MERGE_DIR=/workspace/ComfyUI/input
COMFY_REMOTE_OUTPUT_DIR=/workspace/ComfyUI/output

# ==============================================
# AI Pipeline 설정
# ==============================================

AI_PIPELINE_URL=http://localhost:8001
AI_PIPELINE_MOCK_MODE=false
AI_PIPELINE_DIRECT_MODE=true
BG_CHAR_VOICE_MAX_CONCURRENCY=1

# ==============================================
# 개발/디버깅 설정
# ==============================================

MOCK_MODE=false
DEBUG=false

# ==============================================
# 시나리오 Finetuning
# ==============================================
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_MODEL_NAME=your_runpod_model_name
USE_FINETUNED_SCENARIO=true
FINETUNED_TEMPERATURE=0.7
