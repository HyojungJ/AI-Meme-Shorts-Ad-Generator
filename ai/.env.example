# ==============================================
# 필수 환경 변수
# ==============================================

# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_ID=gpt-4o-mini

# Database (Lightsail PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database_name

DB_HOST=your_db_host                     # 예: localhost 또는 db.example.com
DB_PORT=5432                             # 예: 5432
DB_NAME=your_db_name                     # 예: skn_ai
DB_USER=your_db_user                     # 예: skn_user
DB_PASSWORD=your_db_password             # 예: strong_password

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your_bucket_name

# ==============================================
# AI 서비스 API Keys
# ==============================================

# Nano Banana (이미지 생성)
NANO_BANANA_API_KEY=your_nanobanana_api_key
NANO_BANANA_MODEL=models/gemini-2.5-flash-image               # gemini-2.5-flash-image, gemini-3-pro-image-preview
NANO_BANANA_OUTPUT_DIR=data/images
NANO_BANANA_TEMP_DIR=data/images/tmp
NANO_BANANA_PUBLIC_BASE_URL=your_nanobanana_public_base_url   # 예: https://cdn.example.com/images

NANO_BANANA_STORAGE_BACKEND=s3
NANO_BANANA_STORAGE_PREFIX=images
NANO_BANANA_S3_BUCKET=your_nanobanana_s3_bucket               # 예: skn-ai-images
NANO_BANANA_S3_REGION=your_nanobanana_s3_region               # 예: ap-northeast-2

NANO_BANANA_MAX_RETRIES=5
NANO_BANANA_BASE_SLEEP_SEC=1.0
NANO_BANANA_MAX_SLEEP_SEC=8.0

# ElevenLabs (음성 생성)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MUSIC_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_v3                                  # eleven_multilingual_v2, eleven_v3
ELEVENLABS_TTV_MODEL_ID=eleven_multilingual_ttv_v2             # eleven_multilingual_ttv_v2, eleven_ttv_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_MAX_CUSTOM_VOICES=25

# Qwen3-TTS (음성 생성)
QWEN_TTS_VOICE_DESIGN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QWEN_TTS_BASE_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_TTS_DEVICE=cpu
QWEN_TTS_DTYPE=bfloat16
QWEN_TTS_ATTN_IMPL=flash_attention_2
QWEN_TTS_SEED=42

VOICE_PROVIDER=qwen   # qwen | elevenlabs
VOICE_STORAGE_BACKEND=s3
VOICE_STORAGE_BASE_DIR=data/voice
VOICE_TEMP_DIR=data/voice/tmp
VOICE_PUBLIC_BASE_URL=your_voice_public_base_url                # 예: https://cdn.example.com/voice
VOICE_S3_BUCKET=your_voice_s3_bucket                            # 예: skn-ai-voice
VOICE_S3_REGION=your_voice_s3_region                            # 예: ap-northeast-2

# ==============================================
# ComfyUI (영상 생성)
# ==============================================

COMFY_MODE=comfyui                                              # 실제: comfyui, (추가 : serverless)
COMFY_COMFYUI_BASE_URL=http://127.0.0.1:8188                    # 예: http://127.0.0.1:8188
COMFY_WORKFLOW_PATH=data/comfyui/workflows/ltx2_workflow_v1.json       
COMFY_WORKFLOW_BASE=your_comfy_workflow_base                    # 예: C:\SKN_19\SKN19-FINAL-4TEAM\AI
COMFY_OUTPUT_DIR=data/video
COMFY_TEMP_DIR=data/video/tmp
COMFY_REQUEST_TIMEOUT_SEC=180
COMFY_POLL_INTERVAL_SEC=2.0
COMFY_MAX_WAIT_SEC=900

COMFY_STORAGE_BACKEND=s3
COMFY_PUBLIC_BASE_URL=your_comfy_public_base_url                # 예: https://cdn.example.com/videos
COMFY_S3_BUCKET=your_comfy_s3_bucket                            # 예: skn-ai-videos
COMFY_S3_REGION=your_comfy_s3_region                            # 예: ap-northeast-2
COMFY_STORAGE_PREFIX=videos

# SSH 설정 (ComfyUI 이미지 업로드용)
COMFY_SSH_HOST=your_comfy_ssh_host                              # 예: 10.0.0.12
COMFY_SSH_PORT=your_comfy_ssh_port                              # 예: 22
COMFY_SSH_USER=root
COMFY_SSH_KEY=C:\Users\Playdata\.ssh\id_ed25519                 # 예: C:\Users\user\.ssh\id_ed25519
COMFY_REMOTE_INPUT_DIR=/workspace/ComfyUI/input
COMFY_REMOTE_MERGE_DIR=/workspace/ComfyUI/input
COMFY_REMOTE_OUTPUT_DIR=/workspace/ComfyUI/output

# RunPod Serverless (ComfyUI 서버리스용, 파인튜닝 RUNPOD_*와 별개)
COMFY_RUNPOD_ENDPOINT_ID=your_comfy_runpod_endpoint_id          # 예: abc123xyz

# ==============================================
# 시나리오 Finetuning
# ==============================================
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id                      # 예: abcd1234
RUNPOD_API_KEY=your_runpod_api_key                              # 예: rpod_xxx
RUNPOD_MODEL_NAME=your_runpod_model_name                        # 예: skn-finetuned-model
USE_FINETUNED_SCENARIO=true
FINETUNED_TEMPERATURE=0.7
